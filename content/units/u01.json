  "mission": {
    "id": "u01-m",
    "title_de": "Dreimal grüßen",
    "task_de": "Grüße heute drei Menschen auf Spanisch, passend zur Tageszeit. Verabschiede dich beim Gehen mit ‚Gracias, hasta luego'.",
    "say": [
      "Buenos días.",
      "Buenas tardes.",
      "Gracias, hasta luego."
    ]
  },
  "canarias_de": "‚Hasta luego' ist der Standardabschied in Läden und Cafés, auch wenn man sich nie wiedersieht. ‚Buenos días' gilt in Spanien bis zum Mittagessen gegen 14 Uhr, erst danach sagt man ‚buenas tardes'.",
  "tips_de": [
    "Das h ist immer stumm: hola klingt wie ‚ola'.",
    "ñ klingt wie ‚nj': mañana = ‚manjana'.",
    "ll klingt wie ‚j': me llamo = ‚me jamo'.",
    "j klingt wie das ‚ch' in ‚Bach', auf den Kanaren weicher, fast wie ein ‚h'.",
    "z und c vor e oder i sprechen Kanarier wie ‚s': gracias = ‚grasias'. Die spanische Stimme des iPhones lispelt diese Laute meist wie auf dem Festland. Beides wird überall verstanden.",
    "Fragen und Ausrufe bekommen vorn ein umgedrehtes Zeichen: ¿…? und ¡…!",
    "Endet ein Wort auf Vokal, n oder s, wird die vorletzte Silbe betont, sonst die letzte. Ein Akzent (á, é, í, ó, ú) markiert die Ausnahmen."
  ]
}
