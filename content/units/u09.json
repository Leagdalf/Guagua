  "dialogue": {
    "setting_de": "An der Rezeption",
    "lines": [
      {
        "speaker": "Tú",
        "es": "Perdón, ¿a qué hora abre el restaurante?",
        "de": "Entschuldigung, um wie viel Uhr öffnet das Restaurant?",
        "learner": true
      },
      {
        "speaker": "Recepcionista",
        "es": "Hoy abre a las siete. Ahora está cerrado.",
        "de": "Heute öffnet es um sieben. Jetzt ist es geschlossen.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Gracias. ¿Y mañana?",
        "de": "Danke. Und morgen?",
        "learner": true
      },
      {
        "speaker": "Recepcionista",
        "es": "Mañana abre a la una.",
        "de": "Morgen öffnet es um eins.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Perfecto. Mañana por la mañana vamos a la playa y luego vamos a comer aquí.",
        "de": "Perfekt. Morgen Vormittag gehen wir an den Strand und danach essen wir hier.",
        "learner": true
      },
      {
        "speaker": "Recepcionista",
        "es": "¡Muy bien! ¿Reservo una mesa?",
        "de": "Sehr gut! Soll ich einen Tisch reservieren?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Sí, por favor. Para dos, a las dos.",
        "de": "Ja, bitte. Für zwei, um zwei.",
        "learner": true
      }
    ]
  },
