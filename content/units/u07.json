        "learner": true
      },
      {
        "speaker": "Vecina",
        "es": "Bien, gracias. ¿Están de vacaciones?",
        "de": "Gut, danke. Seid ihr im Urlaub?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Sí, estamos de vacaciones. Somos de Alemania.",
        "de": "Ja, wir sind im Urlaub. Wir kommen aus Deutschland.",
        "learner": true
      },
      {
        "speaker": "Vecina",
        "es": "¡Qué bien! Y hablas español.",
        "de": "Wie schön! Und du sprichst Spanisch.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Hablo un poco. Estudio español todos los días.",
        "de": "Ich spreche ein bisschen. Ich lerne jeden Tag Spanisch.",
        "learner": true
      },
      {
        "speaker": "Vecina",
        "es": "Pues hablas muy bien.",
        "de": "Du sprichst aber sehr gut.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Gracias. Más despacio, por favor.",
        "de": "Danke. Langsamer, bitte.",
        "learner": true
      }
    ]
  },
