  "dialogue": {
    "setting_de": "Gespräch mit der Nachbarin der Unterkunft",
    "lines": [
      {
        "speaker": "Vecina",
        "es": "¡Hola! ¿Qué tal?",
        "de": "Hallo! Wie geht's?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Muy bien, gracias. ¿Y tú?",
