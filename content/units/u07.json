  "grammar": {
    "topic_de": "Regelmäßige Verben auf -ar: hablo, hablas, habla, hablamos",
    "explanation_de": "Die meisten spanischen Verben enden auf -ar. Für die Gegenwart ersetzt du -ar durch eine Endung: -o für ich, -as für du, -a für er, sie und Sie, -amos für wir. So funktionieren hablar (sprechen), trabajar (arbeiten), estudiar (lernen), nadar (schwimmen) und viele andere.",
    "table": [
      {
        "label_de": "ich",
        "es": "(yo) hablo",
        "de": "ich spreche"
      },
      {
        "label_de": "du",
        "es": "(tú) hablas",
        "de": "du sprichst"
      },
      {
        "label_de": "er, sie, Sie",
        "es": "(él, ella, usted) habla",
        "de": "er spricht, sie spricht, Sie sprechen"
      },
      {
        "label_de": "wir",
        "es": "(nosotros) hablamos",
        "de": "wir sprechen"
      }
    ],
