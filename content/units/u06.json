  "dialogue": {
    "setting_de": "In einem Obst- und Gemüseladen",
    "lines": [
      {
        "speaker": "Frutero",
        "es": "¡Buenas! ¿Qué le pongo?",
        "de": "Hallo! Was darf es sein?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Hola. Quiero medio kilo de plátanos, por favor.",
        "de": "Hallo. Ich möchte ein halbes Kilo Bananen, bitte.",
        "learner": true
      },
      {
        "speaker": "Frutero",
        "es": "¿Algo más?",
        "de": "Noch etwas?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Sí, dos aguacates y un kilo de tomates.",
        "de": "Ja, zwei Avocados und ein Kilo Tomaten.",
        "learner": true
      },
      {
        "speaker": "Frutero",
        "es": "Muy bien. ¿Quiere una bolsa?",
        "de": "Sehr gut. Möchten Sie eine Tüte?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "No, gracias. Nada más. ¿Cuánto es?",
        "de": "Nein, danke. Das ist alles. Was macht das?",
        "learner": true
      },
      {
        "speaker": "Frutero",
        "es": "Son seis euros con veinte.",
        "de": "Das macht sechs Euro zwanzig.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "¿Puedo pagar con tarjeta?",
        "de": "Kann ich mit Karte zahlen?",
        "learner": true
      },
      {
        "speaker": "Frutero",
        "es": "Claro que sí.",
        "de": "Aber sicher.",
        "learner": false
      }
    ]
  },
