  "dialogue": {
    "setting_de": "Am Fährschalter im Hafen",
    "lines": [
      {
        "speaker": "Tú",
        "es": "Buenos días. Dos billetes para La Gomera, por favor.",
        "de": "Guten Morgen. Zwei Fahrkarten nach La Gomera, bitte.",
        "learner": true
      },
      {
        "speaker": "Empleada",
        "es": "¿Ida y vuelta?",
        "de": "Hin und zurück?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Sí, ida y vuelta. ¿A qué hora sale el barco?",
        "de": "Ja, hin und zurück. Um wie viel Uhr fährt das Schiff ab?",
        "learner": true
      },
      {
        "speaker": "Empleada",
        "es": "Sale a las nueve. ¿Llevan coche?",
        "de": "Es fährt um neun. Haben Sie ein Auto dabei?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "No, sin coche. ¿Puedo pagar con tarjeta?",
        "de": "Nein, ohne Auto. Kann ich mit Karte zahlen?",
        "learner": true
      },
      {
        "speaker": "Empleada",
        "es": "Claro. Aquí tienen los billetes. ¡Buen viaje!",
        "de": "Natürlich. Hier sind die Fahrkarten. Gute Reise!",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "¡Muchas gracias!",
        "de": "Vielen Dank!",
        "learner": true
      }
    ]
  },
