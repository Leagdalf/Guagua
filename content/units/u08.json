  "dialogue": {
    "setting_de": "Am Strand",
    "lines": [
      {
        "speaker": "Tú",
        "es": "¡Qué bonito! Me encanta esta playa.",
        "de": "Wie schön! Ich finde diesen Strand toll.",
        "learner": true
      },
      {
        "speaker": "Vecino",
        "es": "Sí, es muy bonita. ¿Te gusta nadar?",
        "de": "Ja, er ist sehr schön. Schwimmst du gern?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Sí, me gusta mucho. Pero el agua está fría.",
        "de": "Ja, sehr gern. Aber das Wasser ist kalt.",
        "learner": true
      },
      {
        "speaker": "Vecino",
        "es": "Un poco. Pero hoy hace sol y no hace viento.",
        "de": "Ein bisschen. Aber heute scheint die Sonne und es ist nicht windig.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Sí, hace calor. ¿Tienes crema solar?",
        "de": "Ja, es ist heiß. Hast du Sonnencreme?",
        "learner": true
      },
      {
        "speaker": "Vecino",
        "es": "Claro, aquí tienes.",
        "de": "Klar, hier bitte.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "¡Muchas gracias!",
        "de": "Vielen Dank!",
        "learner": true
      }
    ]
  },
