  "dialogue": {
    "setting_de": "Abendessen in einem Fischrestaurant",
    "lines": [
      {
        "speaker": "Tú",
        "es": "Buenas noches. ¿Tiene una mesa para dos?",
        "de": "Guten Abend. Haben Sie einen Tisch für zwei?",
        "learner": true
      },
      {
        "speaker": "Camarero",
        "es": "Sí, claro. Aquí tienen la carta.",
        "de": "Ja, natürlich. Hier ist die Karte.",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Gracias. De primero, papas arrugadas con mojo.",
        "de": "Danke. Als ersten Gang Runzelkartoffeln mit Mojo.",
        "learner": true
      },
      {
        "speaker": "Camarero",
        "es": "¿Y de segundo?",
        "de": "Und als Hauptgang?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Pescado del día con ensalada.",
        "de": "Fisch des Tages mit Salat.",
        "learner": true
      },
      {
        "speaker": "Camarero",
        "es": "Muy bien. ¿Y para beber?",
        "de": "Sehr gut. Und zu trinken?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Un agua sin gas, por favor.",
        "de": "Ein stilles Wasser, bitte.",
        "learner": true
      },
      {
        "speaker": "Camarero",
        "es": "¿Qué tal todo?",
        "de": "Schmeckt alles?",
        "learner": false
      },
      {
        "speaker": "Tú",
        "es": "Está muy rico, gracias.",
        "de": "Es schmeckt sehr gut, danke.",
        "learner": true
      }
    ]
  },
